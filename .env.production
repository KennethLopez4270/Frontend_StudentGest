# =====================================================
# Variables de entorno para PRODUCCIÓN
# Reemplazar estas URLs con los dominios reales de tu despliegue
# =====================================================

# URL del API Gateway (donde está desplegado tu backend)
# Ejemplo Railway: https://studentgest-gateway.up.railway.app
# Ejemplo Render: https://studentgest-gateway.onrender.com
VITE_API_URL=https://tu-dominio-backend.com

# URL del servicio de usuarios (si accedes directamente sin pasar por el gateway)
# En la mayoría de casos deberías usar el gateway
VITE_USER_SERVICE_URL=https://tu-dominio-backend.com

# URL del servicio de foro (si accedes directamente sin pasar por el gateway)
VITE_FORO_SERVICE_URL=https://tu-dominio-backend.com
